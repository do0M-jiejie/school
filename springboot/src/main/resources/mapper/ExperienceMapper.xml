<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.suse.hwj.springboot.mapper.ExperienceMapper">
    <select id="selectAll" resultType="com.suse.hwj.springboot.entity.Experience">
        select * from experience
        <where>
            <if test="dto.title != null"> title like concat('%', #{dto.title},'%')</if>
        </where>
        order by publish_time desc
    </select>
</mapper>