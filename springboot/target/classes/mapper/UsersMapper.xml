<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.suse.hwj.springboot.mapper.UsersMapper">

    <select id="selectAll" resultType="com.suse.hwj.springboot.entity.Users">
        select * from users
        <where>
            <if test="dto.username != null"> username like concat('%', #{dto.username},'%')</if>
        </where>
        order by user_id desc
    </select>

    <insert id="insert" parameterType="com.suse.hwj.springboot.entity.Users" useGeneratedKeys="true" keyProperty="userId">
        insert into `users` (username,password,role,gender,email,phone)
        values (#{username},#{password},#{role},#{gender},#{email},#{phone})
    </insert>

    <update id="updateById" parameterType="com.suse.hwj.springboot.entity.Users">
        update `users`
        <set>
            <if test="dto.username != null">username = #{dto.username},</if>
            <if test="dto.password != null">password = #{dto.password},</if>
            <if test="dto.role != null">role = #{dto.role},</if>
            <if test="dto.email != null">email = #{dto.email},</if>
            <if test="dto.phone != null">phone = #{dto.phone},</if>
            <if test="dto.height != null">height = #{dto.height},</if>
            <if test="dto.weight != null">weight = #{dto.weight},</if>
            <if test="dto.status != null">status = #{dto.status},</if>
        </set>
        where user_id = #{dto.userId}
    </update>
</mapper>